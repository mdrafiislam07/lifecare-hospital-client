# Local development (backend :5000 e cholle)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Docker/nginx e: NEXT_PUBLIC_API_URL=/api  ar INTERNAL_API_URL=http://nginx/api
# INTERNAL_API_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile site key (optional; khali thakle CAPTCHA dekhabe na). Backend e TURNSTILE_SECRET dite hobe
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
